<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy full-backup rules (Android 11 and older). Backup is off for this app: nothing in the
  app-private storage (message history, provisioned model files) may leave the device.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
