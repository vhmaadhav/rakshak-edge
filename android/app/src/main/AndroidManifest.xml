<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline by construction. This manifest declares no INTERNET permission, no READ_SMS or
  RECEIVE_SMS permission, and no network or location permission of any kind. A message reaches
  the app only when the user pastes it or shares it from another app through the system share
  sheet (ACTION_SEND, text/plain). Nothing is uploaded, and no code path opens a socket.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
