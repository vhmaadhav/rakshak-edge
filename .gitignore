# raw datasets (downloaded, not committed)
/data/

# Kaggle launcher outputs (kernel source and downloaded results)
kaggle/out/

# Colab launcher outputs (runner source, data archive, downloaded results, launch logs)
colab/out/

# Python and tool caches, local virtualenv, OS and notebook leftovers
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/
.DS_Store

# Benchmark results pulled from the Pi (deploy/pi/bench/rbench-remote pull)
/bench_results/

# Local eval outputs (contain dataset SMS text; rebuild with deploy/pi/service/build_hinglish_rows.py)
/results/
